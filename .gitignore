# =============================================================================
# Airymax Ecosystem Module — .gitignore
# 策略：非必要不追踪。仅忽略本地构建产物与运行时数据，
#       源码与必要配置保持可追踪，避免误推远程仓库
# =============================================================================

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---------- 虚拟环境 ----------
venv/
env/
ENV/
.venv/
.python-version

# ---------- 包管理产物 ----------
*.egg-info/
*.egg
*.dist-info/
dist/
build/
wheels/
*.whl

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
test-results/
test_output/

# ---------- IDE 与编辑器配置 ----------
.vscode/
.idea/
.vs/
.trae/
*.code-workspace
.cache/

# ---------- 构建目录 ----------
build-*/
cmake-build-*/
out/

# ---------- 环境与密钥（禁止入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# ---------- 运行时数据 ----------
*.log
*.sock
*.db
*.tmp
*.bak
tmp/
temp/

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db

# ---------- 编辑器临时文件 ----------
*.swp
*.swo
*~
